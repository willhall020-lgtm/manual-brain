{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/forms/**",
              "components/layout/**",
              "components/mobile/**",
              "components/tasks/**",
              "ui_kits/dashboard/**",
              "ui_kits/ios/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|filled|size|onClick|key|ref|className|style|children)$/]",
        "message": "<AddButton> doesn't accept that prop. Declared props: label, filled, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|touch)$/]",
        "message": "<AddButton> size must be one of 'md' | 'touch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddListCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:adding|value|onOpen|onChange|onKeyDown|onCreate|key|ref|className|style|children)$/]",
        "message": "<AddListCard> doesn't accept that prop. Declared props: adding, value, onOpen, onChange, onKeyDown, onCreate."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|text|urgency|custom|due|minutes|when|repeat|sections|selectedSectionId|onClose|onTextChange|onCustomChange|onUrgencyChange|onSectionPick|onDueChange|onMinutesChange|onWhenChange|onRepeatChange|onAdd|key|ref|className|style|children)$/]",
        "message": "<AddSheet> doesn't accept that prop. Declared props: open, text, urgency, custom, due, minutes, when, repeat, sections, selectedSectionId, onClose, onTextChange, onCustomChange, onUrgencyChange, onSectionPick, onDueChange, onMinutesChange, onWhenChange, onRepeatChange, onAdd."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaList'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|showNow|source|label|key|ref|className|style|children)$/]",
        "message": "<AgendaList> doesn't accept that prop. Declared props: before, after, showNow, source, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|key|ref|className|style|children)$/]",
        "message": "<BackButton> doesn't accept that prop. Declared props: label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|meta|barColor|dim|key|ref|className|style|children)$/]",
        "message": "<CalendarEvent> doesn't accept that prop. Declared props: time, title, meta, barColor, dim."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|children|pending|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: from, children, pending."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:me|brain)$/]",
        "message": "<ChatBubble> from must be one of 'me' | 'brain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|busy|onChange|onSend|key|ref|className|style|children)$/]",
        "message": "<ChatComposer> doesn't accept that prop. Declared props: value, placeholder, busy, onChange, onSend."
