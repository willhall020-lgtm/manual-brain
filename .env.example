# Neon Postgres connection string — from your Neon project dashboard
# ("Connection Details" — pick the "Pooled connection" string).
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional — Google Calendar sidebar. Google Calendar → Settings → pick a
# calendar → "Integrate calendar" → "Secret address in iCal format".
# Treat this like a password: anyone with the URL can read that calendar.
GCAL_ICS_URL=

# Optional — gates the whole site behind one shared password (proxy.ts).
# No-ops (site stays open) if unset. Still what the web dashboard's /login
# uses; the native iOS app uses Sign in with Apple instead (below) and
# never sees this value.
SITE_PASSWORD=

# Optional — enables "Sign in with Apple" for the native iOS app (see
# ios/README.md and lib/apple-auth.ts). This is your app's bundle
# identifier (e.g. xyz.manualbrain.ios, from ios/ManualBrain/project.yml) —
# not a secret, it just has to match the App ID you enable the "Sign In
# with Apple" capability on in the Apple Developer portal. No private key
# or Services ID needed: the native flow hands the server an
# already-signed identity token, verified against Apple's public keys.
# The first Apple account that ever signs in this way becomes this
# deploy's one permanent owner (an onboarding claim on the existing data,
# not a multi-user account system — see schema.sql's `users` table).
APPLE_APP_BUNDLE_ID=

# Optional — Google Calendar write access, used by the chat's schedule_task
# tool. Google Cloud Console → new project → enable Calendar API → OAuth
# consent screen (External, add yourself as a test user) → Credentials →
# OAuth client ID (Web application) → redirect URI
# <your-domain>/api/auth/google/callback (+ http://localhost:3000/... for
# local dev). Then connect at /settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — the /chat tool-use loop. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Optional — required for the 09:15 BST morning cron
# (app/api/cron/morning-schedule) to run at all; without it the endpoint
# refuses every request, including Vercel's own. Any random string —
# `openssl rand -hex 32`. Vercel automatically sends it as
# `Authorization: Bearer <value>` on cron requests once this var is set;
# locally it just makes the route unreachable without the header.
CRON_SECRET=
