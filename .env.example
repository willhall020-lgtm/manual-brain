# Neon Postgres connection string — from your Neon project dashboard
# ("Connection Details" — pick the "Pooled connection" string).
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional — Google Calendar sidebar. Google Calendar → Settings → pick a
# calendar → "Integrate calendar" → "Secret address in iCal format".
# Treat this like a password: anyone with the URL can read that calendar.
GCAL_ICS_URL=

# Optional — "Send today → Slack" button. Slack app → Incoming Webhooks →
# Add New Webhook to Workspace → pick the channel your Claude routine reads.
SLACK_WEBHOOK_URL=
